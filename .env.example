# Twitter / X API 認証情報
# https://developer.twitter.com/en/portal/dashboard でアプリを作成して取得

API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
ACCESS_TOKEN=your_access_token_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here
BEARER_TOKEN=your_bearer_token_here

# 自分のX ユーザーID（数字）
MY_USER_ID=your_numeric_user_id_here

# ── Indeed 雇用主アカウント ────────────────────────────────────────
INDEED_EMAIL=your_indeed_email@example.com
INDEED_PASSWORD=your_indeed_password

# Indeed 求人URL（Xへの誘導リンクに使用）
INDEED_JOB_URL=https://jp.indeed.com

# アナリティクス参照期間（日数）: 7 / 14 / 30
INDEED_ANALYTICS_DAYS=7

# ブラウザ表示モード: true=バックグラウンド / false=画面表示（動作確認時に便利）
INDEED_HEADLESS=true
